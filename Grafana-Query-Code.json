from(bucket: "bakkar")
  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)
  |> filter(fn: (r) =>
      r._measurement == "device_frmpayload_data_temperatureC" and
      r._field == "value" and
      r.application_name == "testraed" and
      r.dev_eui == "69a8cc13ca13dcb4"
  )
  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)
  |> group(columns: ["f_port"])   // <- eine Serie je Node/FPort
